---
// The introduction to a work (src/content/introductions), shown above the text on reader pages:
// a description of the work, the history of this edition, and the sources consulted.
import { render } from 'astro:content';
import { marked } from 'marked';
import { editionHistory, type Introduction } from '../lib/introductions';

interface Props {
	intro: Introduction;
	/** The edition being read; its history is shown if the introduction has one. */
	editionRef: string;
	editionLabel: string;
}

const { intro, editionRef, editionLabel } = Astro.props;
const { Content } = await render(intro);
const history = editionHistory(intro, editionRef);
// Introductions are files in this repository, so their Markdown is trusted.
const historyHtml = history ? await marked.parse(history) : undefined;
const { sources, updated } = intro.data;
const date = updated.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="introduction" aria-labelledby="introduction">
	<h2 id="introduction">Introduction</h2>
	<Content />

	{
		historyHtml && (
			<>
				<h3 id="about-this-edition">About this edition: {editionLabel}</h3>
				<Fragment set:html={historyHtml} />
			</>
		)
	}

	<details class="intro-sources">
		<summary>Sources ({sources.length})</summary>
		<ol>
			{
				sources.map((s) => (
					<li>
						<a href={s.url}>{s.title}</a>
						{s.note && <span class="note"> – {s.note}</span>}
					</li>
				))
			}
		</ol>
	</details>
	<p class="intro-status">
		Based on research on the internet; it may contain inaccuracies. <a href="/about/#introductions"
			>About the introductions</a
		> · Updated {date} · <a
			href={`https://github.com/meobtis/meobtis.github.io/blob/main/src/content/introductions/${intro.id}.md`}
			>Suggest a correction</a
		>
	</p>
</section>

<style>
	.introduction {
		margin-top: 2rem;
	}
	.intro-sources {
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
	}
	.intro-sources summary {
		cursor: pointer;
		font-weight: 600;
	}
	.intro-sources .note {
		color: var(--sl-color-gray-3);
	}
	.intro-status {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
