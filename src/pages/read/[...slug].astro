---
// Reader page for one edition: /read/<source>/<sourceId>/.
// The page itself only holds the catalogue entry. The text is fetched from the source's
// repository on GitHub and rendered in the browser by TextReader, so no texts are stored
// in this repository or in the built site.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import Introduction from '../../components/Introduction.astro';
import TextReader from '../../components/TextReader.astro';
import { introductions, referencesOf } from '../../lib/introductions';
import {
	catalog,
	categoryOf,
	categoryUrl,
	readerUrl,
	sourceById,
	type Edition,
	type Work,
} from '../../lib/catalog';

export function getStaticPaths() {
	return catalog.works.flatMap((work) =>
		work.editions.map((edition) => ({ params: { slug: edition.slug }, props: { work, edition } })),
	);
}

interface Props {
	work: Work;
	edition: Edition;
}

const { work, edition } = Astro.props;
const source = sourceById[edition.source];
const place = categoryOf(work);
const others = work.editions.filter((e) => e !== edition);
// Switches: the editions in the current script, and the same text in the other script (same source first).
const sameScript = work.editions.filter((e) => e.script === edition.script);
const otherScript = (edition.script === 'deva' ? 'iast' : 'deva') as 'iast' | 'deva';
const counterpart =
	work.editions.find((e) => e.script === otherScript && e.source === edition.source && (e.transliteratedFrom === edition.ref || edition.transliteratedFrom === e.ref)) ??
	work.editions.find((e) => e.script === otherScript && e.source === edition.source) ??
	work.editions.find((e) => e.script === otherScript);
const scripts = [
	{ id: 'iast', label: 'IAST', lang: 'sa-Latn' },
	{ id: 'deva', label: 'देवनागरी', lang: 'sa-Deva' },
] as const;
const devaSource = edition.transliterated ? work.editions.find((e) => e.ref === edition.transliteratedFrom) : undefined;
const script = edition.script === 'deva' ? 'Devanāgarī' : 'IAST';
const intro = (await introductions()).get(work);
// Index an introduction once in the site search: on the reader page of the work's first edition.
const searchable = Boolean(intro) && edition === work.editions[0];

// SEO: several editions share a work title, so the <title> names the edition too.
const english = intro?.data.englishTitle;
const pageTitle = `${work.title}${english ? ` (${english})` : ''} – ${edition.label}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	'@id': `${pageUrl}#text`,
	url: pageUrl,
	name: work.title,
	...(intro && { description: intro.data.summary }),
	...(intro?.data.englishTitle && { alternativeHeadline: intro.data.englishTitle }),
	...(intro && { citation: referencesOf(intro) }),
	...(work.titleDeva && { alternateName: work.titleDeva }),
	...(work.author && { author: { '@type': 'Person', name: work.author } }),
	inLanguage: edition.script === 'deva' ? 'sa-Deva' : 'sa-Latn',
	...(place && { genre: `${place.group.label} › ${place.category.label}` }),
	about: 'Buddhism',
	bookFormat: 'https://schema.org/EBook',
	isAccessibleForFree: true,
	provider: { '@type': 'Organization', name: source.name, url: source.homepage },
	publisher: { '@type': 'Organization', name: source.publisher },
	creditText: source.credit,
	usageInfo: source.termsUrl,
	isBasedOn: edition.originalUrl,
	encoding: { '@type': 'MediaObject', contentUrl: edition.rawUrl, encodingFormat: 'text/markdown' },
	isPartOf: { '@id': 'https://meobtis.github.io/#website' },
	workExample: others.map((e) => ({ '@type': 'Book', name: e.title, url: new URL(readerUrl(e), Astro.site).href })),
};
---

<StarlightPage
	frontmatter={{
		title: work.title,
		description: intro
			? `${intro.data.summary} Sanskrit text (${script}) from ${source.name}.`
			: `${work.title}${work.author ? ` by ${work.author}` : ''}: Sanskrit text (${script}) from ${source.name}, rendered from Markdown.`,
		tableOfContents: false,
		pagefind: searchable,
		editUrl: false,
		lastUpdated: false,
		head: [
			{ tag: 'title', content: `${pageTitle} | MEOBTIS` },
			{ tag: 'meta', attrs: { property: 'og:title', content: pageTitle } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'book' } },
			{ tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(jsonLd) },
		],
	}}
>
	<div class="meta" data-pagefind-ignore>
		{intro?.data.englishTitle && <p class="english-title">{intro.data.englishTitle}</p>}
		{work.titleDeva && <p class="deva" lang="sa-Deva">{work.titleDeva}</p>}
		<dl>
			{
				work.author && (
					<>
						<dt>Author</dt>
						<dd lang="sa-Latn">{work.author}</dd>
					</>
				)
			}
			<dt>Source</dt>
			<dd>
				<strong>{edition.label}</strong>: {source.name}{edition.transliterated ? ' (transliterated)' : ''}
			</dd>
			{
				place && (
					<>
						<dt>Category</dt>
						<dd>
							<a href="/texts/">Texts</a> › {place.group.label} ›{' '}
							<a href={categoryUrl(place.group, place.category)}>{place.category.label}</a>
						</dd>
					</>
				)
			}
			<dt>Links</dt>
			<dd>
				<a href={edition.url}>Markdown on GitHub</a> · <a href={edition.originalUrl}>Original on {source.label}</a>
			</dd>
		</dl>
		{
			(sameScript.length > 1 || counterpart) && (
				<div class="switches">
					{sameScript.length > 1 && (
						<div class="switch">
							<span class="switch-label" id="edition-label">Edition</span>
							<ul class="segmented" aria-labelledby="edition-label">
								{sameScript.map((e) => (
									<li>
										<a href={readerUrl(e)} aria-current={e === edition ? 'page' : undefined}>
											{e.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}
					{(counterpart || work.editions.some((e) => e.script !== edition.script)) && (
						<div class="switch">
							<span class="switch-label" id="script-label">Script</span>
							<ul class="segmented" aria-labelledby="script-label">
								{scripts.map((sc) => (
									<li>
										{sc.id === edition.script ? (
											<a href={readerUrl(edition)} aria-current="page" lang={sc.lang}>{sc.label}</a>
										) : counterpart ? (
											<a href={readerUrl(counterpart)} lang={sc.lang}>{sc.label}</a>
										) : null}
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			)
		}
	</div>

	{intro && <Introduction intro={intro} editionRef={edition.ref} editionLabel={edition.label} />}

	{intro && <h2 id="text">Text</h2>}
	<div data-pagefind-ignore>
	{
		edition.transliterated && (
			<Aside type="note" title="Transliterated edition">
				<p>
					This is a machine transliteration into IAST of the Devanāgarī edition
					{devaSource ? <> (<a href={readerUrl(devaSource)}>{devaSource.label}</a>)</> : ''}, made with{' '}
					<a href="https://www.aksharamukha.com/python">Aksharamukha</a>. The Devanāgarī text is the authoritative one.
				</p>
			</Aside>
		)
	}

	<Aside type="note" title="Source and terms of use">
		<p>
			{source.credit} <a href={edition.originalUrl}>View this text on the {source.label} website</a>.
		</p>
		<p>
			{source.terms} <a href={source.termsUrl}>Terms</a>. When you quote or reuse this text, please cite the
			source edition given in the edition details and {source.label}.
		</p>
	</Aside>
	</div>

	<TextReader rawUrl={edition.rawUrl} githubUrl={edition.url} lang={edition.script === 'deva' ? 'sa-Deva' : 'sa-Latn'} />
</StarlightPage>

<style>
	.meta .english-title {
		font-size: var(--sl-text-xl);
		font-style: italic;
		margin: 0;
	}
	.meta .deva {
		font-size: var(--sl-text-xl);
		color: var(--sl-color-gray-2);
		margin-top: 0;
	}
	.meta dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1rem;
		font-size: var(--sl-text-sm);
	}
	.meta dt {
		color: var(--sl-color-gray-3);
	}
	.meta dt,
	.meta dd {
		margin: 0;
	}
	.switches {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		margin-top: 1rem;
	}
	.switch {
		display: grid;
		gap: 0.375rem;
	}
	.switch-label {
		font-size: var(--sl-text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}
	.segmented {
		list-style: none;
		margin: 0;
		padding: 0;
		display: inline-flex;
		flex-wrap: wrap;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		overflow: hidden;
		font-size: var(--sl-text-sm);
	}
	.segmented li {
		margin: 0;
	}
	.segmented li + li {
		border-inline-start: 1px solid var(--sl-color-accent);
	}
	.segmented a {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0 1rem;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.segmented a:hover,
	.segmented a:focus-visible {
		background: var(--sl-color-accent-low);
	}
	.segmented a[aria-current='page'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	@media (max-width: 30rem) {
		.meta dl {
			grid-template-columns: 1fr;
		}
		.meta dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
