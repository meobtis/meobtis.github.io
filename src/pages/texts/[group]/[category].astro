---
// One page per category of the catalogue, e.g. /texts/sutra/prajnaparamita/ (works A–Z).
import CategoryView from '../../../components/CategoryView.astro';
import { catalog, type Category, type Group } from '../../../lib/catalog';

export function getStaticPaths() {
	return catalog.groups.flatMap((group) =>
		group.categories
			.filter((category) => category.count > 0)
			.map((category) => ({ params: { group: group.id, category: category.id }, props: { group, category } })),
	);
}

interface Props {
	group: Group;
	category: Category;
}

const { group, category } = Astro.props;
---

<CategoryView group={group} category={category} />
