---
// A list of works. Each work shows its title (IAST, plus Devanāgarī where a source has it) and author,
// one "Read" button for its first edition, and the sources it is available from as plain text.
// Works with several editions list them all, with a link to the original, in a <details> disclosure.
import { readerUrl, sourceById, type Work } from '../lib/catalog';
import { introductions } from '../lib/introductions';

interface Props {
	works: Work[];
	/** Show each work's category under its title (used on the A–Z page). */
	categoryLabels?: Record<string, string>;
}

const { works, categoryLabels } = Astro.props;
const intros = await introductions();

/** Sources of a work in order of first appearance, e.g. ["GRETIL", "DSBC"]. */
const sourcesOf = (w: Work) => [...new Set(w.editions.map((e) => sourceById[e.source]?.label ?? e.source))];
---

<ul class="works not-content">
	{
		works.map((w) => (
			<li class="work">
				<div class="work-main">
					<div class="work-title">
						<span class="iast" lang="sa-Latn">
							{w.title}
						</span>
						{w.titleDeva && (
							<span class="deva" lang="sa-Deva">
								{w.titleDeva}
							</span>
						)}
					</div>
					{intros.get(w)?.data.englishTitle && <div class="english">{intros.get(w)!.data.englishTitle}</div>}
					{intros.get(w) && (
						<p class="summary">
							{intros.get(w)!.data.summary}{' '}
							<a href={`${readerUrl(w.editions[0])}#introduction`}>Introduction</a>
						</p>
					)}
					<div class="work-meta">
						{w.author && <span lang="sa-Latn">{w.author}</span>}
						{categoryLabels && <span>{categoryLabels[w.category]}</span>}
						<span>
							{sourcesOf(w).join(' · ')}
							{w.editions.length > 1 && ` · ${w.editions.length} editions`}
						</span>
					</div>
					{w.editions.length > 1 && (
						<details class="all-editions">
							<summary>All {w.editions.length} editions</summary>
							<ul class="editions" aria-label={`Editions of ${w.title}`}>
								{w.editions.map((e) => (
									<li>
										<a class="edition" href={readerUrl(e)} title={`Read ${e.title} (${sourceById[e.source]?.name ?? e.source})`}>
											{e.label}
										</a>
										<a
											class="original"
											href={e.originalUrl}
											title={`Original on the ${sourceById[e.source]?.label ?? e.source} website`}
											aria-label={`${e.label}: original on ${sourceById[e.source]?.label ?? e.source}`}
										>
											original ↗
										</a>
									</li>
								))}
							</ul>
						</details>
					)}
				</div>
				<a class="read" href={readerUrl(w.editions[0])} aria-label={`Read ${w.title} (${w.editions[0].label})`}>
					Read
				</a>
			</li>
		))
	}
</ul>

<style>
	.works {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0;
	}
	.work {
		padding: 1rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: center;
		justify-content: space-between;
	}
	.work-main {
		flex: 1 1 20rem;
		min-width: 0;
		display: grid;
		gap: 0.25rem;
	}
	.work-title {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.75rem;
	}
	.iast {
		font-weight: 600;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.deva {
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.english {
		color: var(--sl-color-gray-2);
	}
	.summary {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.work-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.read {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		background: var(--sl-color-accent-low);
	}
	.read:hover,
	.read:focus-visible {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.all-editions {
		font-size: var(--sl-text-sm);
	}
	.all-editions summary {
		cursor: pointer;
		color: var(--sl-color-text-accent);
		width: fit-content;
	}
	.editions {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: grid;
		gap: 0.25rem;
	}
	.editions li {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		align-items: baseline;
	}
	.original {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
